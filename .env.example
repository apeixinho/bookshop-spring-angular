# Copy to .env and adjust as needed (never commit .env)

# Ports
AUTH_SERVER_PORT=9000
BACKEND_PORT=8090

# OAuth / OIDC contract
# Token iss claim (must match JWT validation). Use localhost even in Compose;
# backend fetches JWKS via SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI.
AUTH_ISSUER_URI=http://localhost:9000
AUTH_BROWSER_ISSUER_URI=http://localhost:9000
OAUTH_CLIENT_ID=bookshop-spa
OAUTH_AUDIENCE=bookshop-api
FRONTEND_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:8090
OAUTH_REDIRECT_URI=http://localhost:4200/auth/callback
OAUTH_SCOPES=openid profile bookshop.read bookshop.write

# Staging MariaDB (compose.staging.yml)
# bookshop_db = API catalog/orders; bookshop_auth = auth-server users + OAuth clients
MARIADB_DATABASE=bookshop_db
AUTH_MARIADB_DATABASE=bookshop_auth
MARIADB_USERNAME=bookshop_user
MARIADB_PASSWORD=bookshop_pass
MARIADB_ROOT_PASSWORD=bookshop_root_pass
