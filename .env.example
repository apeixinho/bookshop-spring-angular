# Copy to .env and adjust as needed (never commit .env)

# Ports
AUTH_SERVER_PORT=9000
BACKEND_PORT=8090
PAYMENT_SERVER_PORT=8091

# OAuth / OIDC contract
# Token iss claim (must match JWT validation). Use localhost even in Compose;
# backend fetches JWKS via SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI.
AUTH_ISSUER_URI=http://localhost:9000
AUTH_BROWSER_ISSUER_URI=http://localhost:9000
OAUTH_CLIENT_ID=catalog-spa
OAUTH_AUDIENCE=catalog-api
FRONTEND_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:8090
OAUTH_REDIRECT_URI=http://localhost:4200/auth/callback
OAUTH_SCOPES=openid profile catalog.read catalog.write

# Mock payment service (browser hits localhost; containers use service DNS)
PAYMENT_PUBLIC_BASE_URL=http://localhost:8091
PAYMENT_BASE_URL=http://payment-service:8091
PAYMENT_WEBHOOK_URL=http://backend:8090/api/v1/checkout/payment-webhook
PAYMENT_API_SECRET=dev-payment-secret
PAYMENT_WEBHOOK_SECRET=dev-payment-secret
PAYMENT_CHECKOUT_RESULT_URL=http://localhost:4200/checkout/result

# Staging MariaDB (compose.staging.yml)
# catalog_db = API catalog/orders; catalog_auth = auth-server users + OAuth clients
MARIADB_DATABASE=catalog_db
AUTH_MARIADB_DATABASE=catalog_auth
MARIADB_USERNAME=catalog_user
MARIADB_PASSWORD=catalog_pass
MARIADB_ROOT_PASSWORD=catalog_root_pass
